      <TextObject Name="Text2" Left="238.14" Top="122.85" Width="236.25" Height="37.8" Border.Color="White" Fill.Color="110, 145, 190" Text="Reporte de Reuniones" HorzAlign="Center" Font="Arial Black, 12pt" TextRenderType="HtmlTags"/>
      <TextObject Name="Text3" Left="264.6" Top="66.15" Width="170.1" Height="37.8" Border.Color="White" Fill.Color="110, 145, 190" Text="Gestion de semilleros " HorzAlign="Center" Font="Arial Black, 10pt" TextFill.Color="Info" TextRenderType="HtmlTags"/>
      <TextObject Name="Text4" Left="9.45" Top="189" Width="661.5" Height="103.95" Border.Color="White" Fill.Color="110, 145, 190" Text="El presente reporte, generado por el aplicativo CoordinaPro, detalla de manera oficial las sesiones de trabajo de los grupos de investigación. La información se organiza sistemáticamente según el semillero correspondiente, facilitando el seguimiento de compromisos, objetivos estratégicos y la verificación del quórum. Este documento certifica la participación activa y el número de investigadores asistentes, funcionando como soporte técnico para procesos de auditoría y gestión de calidad académica institucional" HorzAlign="Center" Font="Arial Rounded MT Bold, 10pt" TextFill.Color="Info" TextRenderType="HtmlTags"/>
      <TextObject Name="Text5" Left="226.8" Top="302.4" Width="236.25" Height="28.35" Border.Color="White" Fill.Color="110, 145, 190" Text="Reuniones" HorzAlign="Center" Font="Arial Rounded MT Bold, 12pt" TextRenderType="HtmlTags"/>
